---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { formatDateForDisplay } from '@lib/date-formatter';

const entries = await getCollection('archive');
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Archive — stivaros"
  description="Posts from the old blog at blog.stivaros.com, preserved for reference."
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold text-body mb-2">Archive</h1>
    <p class="text-muted">
      Posts from the old blog at blog.stivaros.com, preserved for reference.
    </p>
  </header>

  {
    entries.length === 0 ? (
      <p class="text-muted">No posts yet.</p>
    ) : (
      <ul class="link-fill space-y-8">
        {entries.map((entry) => (
          <li>
            <a href={`/archive/${entry.id}`} class="text-lg font-medium">
              {entry.data.title}
            </a>
            <div class="mt-1 flex items-baseline gap-2 text-sm text-muted">
              <time datetime={entry.data.date.toISOString()} class="tabular-nums shrink-0">
                {formatDateForDisplay(entry.data.date)}
              </time>
              {entry.data.description && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>{entry.data.description}</span>
                </>
              )}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
