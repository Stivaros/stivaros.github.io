---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { formatDateForDisplay } from '@lib/date-formatter';

const entries = await getCollection('archive');
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Archive — stivaros"
  description="Posts from the old blog at blog.stivaros.com, preserved for reference."
>
  <header class="mb-10">
    <h1 class="text-3xl font-bold text-body mb-2">Archive</h1>
    <p class="text-muted">
      Posts from the old blog at blog.stivaros.com, preserved for reference.
    </p>
  </header>

  {
    entries.length === 0 ? (
      <p class="text-muted">No posts yet.</p>
    ) : (
      <ul class="space-y-6">
        {entries.map((entry) => (
          <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
            <time
              datetime={entry.data.date.toISOString()}
              class="text-sm text-muted shrink-0 tabular-nums"
            >
              {formatDateForDisplay(entry.data.date)}
            </time>
            <div class="flex items-baseline gap-3 flex-wrap">
              <a href={`/archive/${entry.slug}`} class="text-body">
                {entry.data.title}
              </a>
              <span class="text-xs font-medium text-amber-300 border border-amber-400/40 rounded px-1.5 py-0.5 leading-none light:text-amber-800 light:border-amber-500/60">
                Historical
              </span>
            </div>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
