---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const entries = await getCollection('thoughts');
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout
  title="Thoughts — stivaros"
  description="Technical notes, observations, and short essays."
>
  <div class="term-prompt mb-4">
    <span class="text-accent">$</span>
    <span class="ml-1">ls thoughts/ --long --tagged</span>
  </div>

  <h1 class="term-dir-title mb-2">thoughts/</h1>
  <p class="font-mono text-sm text-zinc-500 light:text-zinc-400 mb-8 ml-4">
    # weekly-ish notes on engineering, systems, the act of programming
  </p>

  {
    entries.length === 0 ? (
      <p class="term-prompt">No posts yet.</p>
    ) : (
      <div class="link-fill font-mono text-sm overflow-x-auto">
        {entries.map((entry) => {
          const date = entry.data.date.toISOString().slice(0, 10);
          const tag = entry.data.tags?.[0] ?? '';
          return (
            <div class="grid grid-cols-[100px_1fr_80px] sm:grid-cols-[100px_60px_1fr_80px] gap-4 py-2.5 items-baseline border-b border-dashed border-zinc-800 light:border-zinc-200 min-w-[360px]">
              <span class="text-zinc-500 text-xs">{date}</span>
              <span class="hidden sm:block text-zinc-600 text-xs text-right">—</span>
              <a href={`/thoughts/${entry.id}`} class="text-sm font-medium truncate">
                {entry.data.title}
              </a>
              <span class="text-right text-xs text-accent">
                {tag && `#${tag}`}
              </span>
            </div>
          );
        })}
      </div>
    )
  }

  <div class="term-prompt mt-6">
    <span class="text-accent">$</span>
    <span class="ml-1">_</span>
  </div>
</BaseLayout>
