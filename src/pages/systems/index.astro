---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';

const entries: CollectionEntry<'systems'>[] = await getCollection('systems');
---

<BaseLayout
  title="Systems — stivaros"
  description="Case studies in engineering and product."
>
  <div class="term-prompt mb-4">
    <span class="text-accent">$</span>
    <span class="ml-1">systems --list</span>
  </div>

  <h1 class="term-dir-title mb-2">systems/</h1>
  <p class="font-mono text-sm text-zinc-500 light:text-zinc-400 mb-8 ml-4">
    # case studies — each ships with a logic toggle: prose / diagram
  </p>

  {
    entries.length === 0 ? (
      <p class="term-prompt">No case studies yet.</p>
    ) : (
      <div class="link-fill overflow-x-auto">
        {entries.map((entry, i) => {
          const id = `sys-${String(i + 1).padStart(3, '0')}`;
          const stack = entry.data.technology.join('/');
          return (
            <div class="grid grid-cols-[80px_1fr] sm:grid-cols-[80px_1fr_180px] gap-4 py-5 border-t border-zinc-800 light:border-zinc-200 items-baseline min-w-[360px]">
              <span class="font-mono text-xs text-accent">{id}</span>
              <div>
                <a href={`/systems/${entry.id}`} class="text-lg font-semibold block mb-1">
                  {entry.data.title}
                </a>
                <p class="font-mono text-xs text-zinc-500 light:text-zinc-400">
                  {entry.data.impact}
                </p>
              </div>
              <div class="hidden sm:block font-mono text-xs text-right">
                <span class="text-zinc-500">stack:</span>
                <span class="text-zinc-400 light:text-zinc-500 ml-1">{stack}</span>
              </div>
            </div>
          );
        })}
        <div class="border-t border-zinc-800 light:border-zinc-200" />
      </div>
    )
  }
</BaseLayout>
