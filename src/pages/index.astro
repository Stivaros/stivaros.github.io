---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="stivaros"
  description="Engineer. Writing about systems, craft, and the work."
>
  <section class="mb-16">
    <h1 class="text-4xl font-bold text-body mb-3">stivaros</h1>
    <p class="text-lg text-muted">
      Engineer. Writing about systems, craft, and the work.
    </p>
  </section>

  <section class="grid gap-6 sm:grid-cols-2">
    <a href="/dispatch" class="card block px-6 py-5 group no-underline">
      <h2
        class="text-xl font-semibold text-body mb-2 underline decoration-emerald-400 decoration-2 underline-offset-4 group-hover:decoration-emerald-300 transition-colors duration-150 light:decoration-emerald-700 light:group-hover:decoration-emerald-600"
      >
        Dispatch
      </h2>
      <p class="text-sm text-muted">Weekly technical notes.</p>
    </a>

    <a href="/archive" class="card block px-6 py-5 group no-underline">
      <h2
        class="text-xl font-semibold text-body mb-2 underline decoration-emerald-400 decoration-2 underline-offset-4 group-hover:decoration-emerald-300 transition-colors duration-150 light:decoration-emerald-700 light:group-hover:decoration-emerald-600"
      >
        Archive
      </h2>
      <p class="text-sm text-muted">Posts from the old blog, preserved.</p>
    </a>
  </section>
</BaseLayout>
