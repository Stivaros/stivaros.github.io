---
import BaseLayout from './BaseLayout.astro';
import { formatDateForDisplay } from '@lib/date-formatter';

interface Props {
  title: string;
  date?: Date;
  description?: string;
  isLegacy?: boolean;
}

const { title, date, description, isLegacy = false } = Astro.props;
const formattedDate = date ? formatDateForDisplay(date) : null;
---

<BaseLayout title={title} description={description}>
  <article class="max-w-2xl">
    <header class="mb-10">
      <h1 class="text-4xl font-bold text-body mb-3 leading-tight">{title}</h1>
      {date && formattedDate && (
        <time datetime={date.toISOString()} class="text-sm text-muted">
          {formattedDate}
        </time>
      )}
    </header>

    {
      isLegacy && (
        <div role="note" class="legacy-banner">
          <strong class="font-semibold">Historical post</strong> — This was
          written a while ago and may no longer reflect my current thinking or
          the current state of the technology described.
        </div>
      )
    }

    <div class="link-fill prose">
      <slot />
    </div>
  </article>
</BaseLayout>
