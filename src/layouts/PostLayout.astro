---
import BaseLayout from './BaseLayout.astro';
import { formatDateForDisplay } from '@lib/date-formatter';

interface Props {
  title: string;
  date: Date;
  description?: string;
  isLegacy?: boolean;
}

const { title, date, description, isLegacy = false } = Astro.props;
const formattedDate = formatDateForDisplay(date);
---

<BaseLayout title={title} description={description}>
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold text-body mb-2">{title}</h1>
      <time datetime={date.toISOString()} class="text-sm text-muted">
        {formattedDate}
      </time>
    </header>

    {
      isLegacy && (
        <div
          role="note"
          class="mb-8 border-l-4 border-amber-400 bg-zinc-900 px-4 py-3 text-sm text-amber-300 light:bg-zinc-50 light:text-amber-700 light:border-amber-400"
        >
          <strong class="font-semibold">Historical post</strong> — This was
          written a while ago and may no longer reflect my current thinking or
          the current state of the technology described.
        </div>
      )
    }

    <div
      class="[&_h2]:border-l-2 [&_h2]:border-emerald-400 [&_h2]:pl-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:mb-4 [&_h2]:mt-8 light:[&_h2]:border-emerald-600
             [&_p]:mb-4 [&_p]:leading-relaxed
             [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6
             [&_ol]:mb-4 [&_ol]:list-decimal [&_ol]:pl-6"
    >
      <slot />
    </div>
  </article>
</BaseLayout>
