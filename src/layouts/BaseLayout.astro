---
import '@styles/global.css';
import ThemeToggle from '@components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme') || 'dark';
        var html = document.documentElement;
        html.classList.remove('dark', 'light');
        html.classList.add(theme);
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <header class="bg-surface border-b border-subtle">
      <nav class="max-w-3xl mx-auto px-4 py-4 flex items-center gap-6">
        <a href="/" class="no-underline font-semibold text-body">
          stivaros
        </a>
        <!-- dispatch, systems, and archive links rely on the global a base style for underline treatment -->
        <a href="/dispatch">dispatch</a>
        <a href="/systems">systems</a>
        <a href="/archive">archive</a>
        <div class="ml-auto">
          <ThemeToggle />
        </div>
      </nav>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-subtle mt-16">
      <div class="max-w-3xl mx-auto px-4 py-6 text-sm text-muted">
        &copy; {new Date().getFullYear()} stivaros
      </div>
    </footer>
  </body>
</html>
