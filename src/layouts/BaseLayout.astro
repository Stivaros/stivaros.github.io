---
import '@styles/global.css';
import ThemeToggle from '@components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const navLinks = [
  { href: '/thoughts', label: 'thoughts' },
  { href: '/systems',  label: 'systems'  },
  { href: '/archive',  label: 'archive'  },
] as const;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme') || 'dark';
        var html = document.documentElement;
        html.classList.remove('dark', 'light');
        html.classList.add(theme);
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <header class="bg-surface border-b border-subtle">
      <nav class="max-w-4xl mx-auto px-6 py-5 flex items-center gap-8">
        <a href="/" class="nav-logo">
          stivaros
        </a>

        <div class="link-fill contents">
          {navLinks.map(({ href, label }) => (
            isActive(href) ? (
              <a href={href} aria-current="page" class="nav-link-active">
                {label}
              </a>
            ) : (
              <a href={href} class="nav-link">
                {label}
              </a>
            )
          ))}
        </div>

        <div class="ml-auto">
          <ThemeToggle />
        </div>
      </nav>
    </header>

    <main class="max-w-4xl mx-auto px-6 py-12">
      <slot />
    </main>

    <footer class="border-t border-subtle mt-20">
      <div class="max-w-4xl mx-auto px-6 py-6 text-sm text-muted">
        &copy; {new Date().getFullYear()} stivaros
      </div>
    </footer>
  </body>
</html>
