---
import '@styles/global.css';
import ThemeToggle from '@components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const navItems = [
  { href: '/',         path: '~'          },
  { href: '/thoughts', path: '~/thoughts' },
  { href: '/systems',  path: '~/systems'  },
  { href: '/archive',  path: '~/archive'  },
] as const;

const gutterLines = Array.from({ length: 60 }, (_, i) => i + 1);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme') || 'dark';
        var html = document.documentElement;
        html.classList.remove('dark', 'light');
        html.classList.add(theme);
      })();
    </script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('nav-email');
        if (!el) return;
        var email = el.dataset.u + '@' + el.dataset.d;
        el.href = 'mailto:' + email;
        el.innerHTML =
          '<span class="text-accent">' + el.dataset.u + '</span>' +
          '<span class="text-zinc-500">@</span>' +
          '<span class="text-zinc-100 light:text-zinc-900">' + el.dataset.d + '</span>';
      });
    </script>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-zinc-800 light:border-zinc-200 bg-zinc-950 light:bg-white">
      <div class="flex items-stretch font-mono text-xs overflow-x-auto">
        <a
          id="nav-email"
          data-u="efstathios"
          data-d="stivaros.com"
          class="flex items-center px-5 py-3 border-r border-zinc-800 light:border-zinc-200 shrink-0 gap-0"
        ></a>

        {navItems.map(({ href, path }) => (
          isActive(href) ? (
            <a href={href} aria-current="page" class="term-tab term-tab-active">
              <span class="text-zinc-500 light:text-zinc-400">cd</span>{path}
            </a>
          ) : (
            <a href={href} class="term-tab">
              <span class="text-zinc-600 light:text-zinc-400">cd</span>{path}
            </a>
          )
        ))}

        <div class="flex-1" />

        <a href="https://github.com/stivaros/stivaros.github.io" target="_blank" rel="noopener noreferrer" class="hidden sm:flex items-center px-5 border-l border-zinc-800 light:border-zinc-200 text-zinc-600 light:text-zinc-400 hover:text-zinc-400 light:hover:text-zinc-600 shrink-0 transition-colors">
          branch: main
        </a>

        <div class="flex items-center px-3 border-l border-zinc-800 light:border-zinc-200 text-zinc-400 light:text-zinc-500">
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto flex">
      <div
        class="hidden sm:block w-14 shrink-0 font-mono text-[11px] leading-6 text-right pr-4 pt-12 text-zinc-700 light:text-zinc-400 border-r border-zinc-800 light:border-zinc-200 select-none overflow-hidden"
        aria-hidden="true"
      >
        {gutterLines.map(n => <div>{n}</div>)}
      </div>

      <div class="flex-1 min-w-0 px-4 sm:px-8 py-12">
        <slot />
      </div>
    </main>

    <footer class="border-t border-zinc-800 light:border-zinc-200 mt-12">
      <div class="max-w-4xl mx-auto px-6 py-6 text-xs text-zinc-600 font-mono">
        &copy; {new Date().getFullYear()} stivaros
      </div>
    </footer>
  </body>
</html>
