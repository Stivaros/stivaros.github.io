---
import '@styles/global.css';
import ThemeToggle from '@components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const navItems = [
  { href: '/',         path: '~'          },
  { href: '/thoughts', path: '~/thoughts' },
  { href: '/systems',  path: '~/systems'  },
  { href: '/archive',  path: '~/archive'  },
] as const;

const gutterLines = Array.from({ length: 60 }, (_, i) => i + 1);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <script is:inline>
      (function () {
        var theme = localStorage.getItem('theme') || 'dark';
        var html = document.documentElement;
        html.classList.remove('dark', 'light');
        html.classList.add(theme);
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <header class="border-b border-zinc-800 light:border-zinc-200 bg-zinc-950 light:bg-white">
      <div class="flex items-stretch font-mono text-xs overflow-x-auto">
        {navItems.map(({ href, path }) => {
          const active = isActive(href);
          const isHome = href === '/';
          return active ? (
            <a href={href} aria-current="page" class="term-tab term-tab-active">
              <span class="text-zinc-500 light:text-zinc-400">cd</span>
              {isHome ? (
                <>{path}<span class="text-zinc-600 light:text-zinc-400"> | </span><span class="text-zinc-300 light:text-zinc-600">home</span></>
              ) : path}
            </a>
          ) : (
            <a href={href} class:list={["term-tab", "group", isHome && "pr-8"]}>
              <span class="text-zinc-600 light:text-zinc-400 group-hover:text-zinc-400 light:group-hover:text-zinc-600 transition-colors">cd</span>
              {isHome ? (
                <>{path}<span class="text-zinc-700 light:text-zinc-500 group-hover:text-zinc-500 transition-colors"> | </span><span class="text-emerald-400 light:text-emerald-600 group-hover:text-emerald-300 light:group-hover:text-emerald-500 transition-colors">home</span></>
              ) : path}
            </a>
          );
        })}

        <div class="flex-1" />

        <div class="flex items-center px-3 border-l border-zinc-800 light:border-zinc-200 text-zinc-400 light:text-zinc-500">
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main class="max-w-4xl mx-auto flex">
      <div
        class="hidden sm:block w-14 shrink-0 font-mono text-[11px] leading-6 text-right pr-4 pt-12 text-zinc-700 light:text-zinc-400 border-r border-zinc-800 light:border-zinc-200 select-none overflow-hidden"
        aria-hidden="true"
      >
        {gutterLines.map(n => <div>{n}</div>)}
      </div>

      <div class="flex-1 min-w-0 px-4 sm:px-8 py-12">
        <slot />
      </div>
    </main>

    <footer class="border-t border-zinc-800 light:border-zinc-200 mt-12">
      <div class="max-w-4xl mx-auto px-6 py-10 font-mono text-sm">

        <div class="text-zinc-500 light:text-zinc-400 mb-6">
          <span class="text-accent">$</span> man stivaros
        </div>

        <div class="space-y-6 text-zinc-300 light:text-zinc-700">

          <div class="flex justify-between text-zinc-500 light:text-zinc-400 text-xs">
            <span>STIVAROS(1)</span>
            <span>Personal Site</span>
            <span>STIVAROS(1)</span>
          </div>

          <div>
            <div class="text-zinc-100 light:text-zinc-900 font-bold mb-1">NAME</div>
            <div class="pl-8">stivaros &ndash; software engineer</div>
          </div>

          <div>
            <div class="text-zinc-100 light:text-zinc-900 font-bold mb-1">SYNOPSIS</div>
            <div class="pl-8">
              stivaros [<a href="/thoughts" class="text-accent hover:text-zinc-100 light:hover:text-zinc-900 transition-colors">--thoughts</a>] [<a href="/systems" class="text-accent hover:text-zinc-100 light:hover:text-zinc-900 transition-colors">--systems</a>] [<a href="/archive" class="text-accent hover:text-zinc-100 light:hover:text-zinc-900 transition-colors">--archive</a>]
            </div>
          </div>

          <div>
            <div class="text-zinc-100 light:text-zinc-900 font-bold mb-1">CONTACT</div>
            <div class="pl-8">
              <a
                id="footer-email"
                data-u="efstathios"
                data-d="stivaros.com"
                class="hover:text-zinc-100 light:hover:text-zinc-900 transition-colors"
              >efstathios@stivaros.com</a>
            </div>
          </div>

          <div>
            <div class="text-zinc-100 light:text-zinc-900 font-bold mb-1">SOURCE</div>
            <div class="pl-8">
              <a href="https://github.com/stivaros/stivaros.github.io" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-100 light:hover:text-zinc-900 transition-colors">
                github.com/stivaros/stivaros.github.io
              </a>
            </div>
          </div>

          <div>
            <div class="text-zinc-100 light:text-zinc-900 font-bold mb-1">SEE ALSO</div>
            <div class="link-fill pl-8 flex flex-wrap gap-x-6 gap-y-1">
              <a href="https://ruby.social/@Stath" target="_blank" rel="noopener noreferrer">mastodon(1)</a>
              <a href="https://github.com/stivaros" target="_blank" rel="noopener noreferrer">github(1)</a>
              <a href="https://bsky.app/profile/stivaros.com" target="_blank" rel="noopener noreferrer">bsky(1)</a>
              <a href="https://www.linkedin.com/in/estivaros/" target="_blank" rel="noopener noreferrer">linkedin(1)</a>
            </div>
          </div>

          <div>
            <div class="text-zinc-100 light:text-zinc-900 font-bold mb-1">COPYRIGHT</div>
            <div class="pl-8 text-zinc-500 light:text-zinc-400">
              &copy; {new Date().getFullYear()} stivaros
            </div>
          </div>

        </div>
      </div>

      <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
          var el = document.getElementById('footer-email');
          if (!el) return;
          var email = el.dataset.u + '@' + el.dataset.d;
          el.href = 'mailto:' + email;
        });
      </script>
    </footer>

    <button
      id="back-to-top"
      aria-label="Back to top"
      class="fixed bottom-6 right-6 z-50 font-mono text-xs px-3 py-2
             bg-zinc-900 light:bg-zinc-100
             border border-zinc-700 light:border-zinc-300
             text-zinc-400 light:text-zinc-500
             hover:text-zinc-100 light:hover:text-zinc-900
             hover:border-zinc-500 light:hover:border-zinc-400
             transition-all duration-200
             opacity-0 pointer-events-none translate-y-2"
    >↑ top</button>

    <script is:inline>
      (function () {
        var btn = document.getElementById('back-to-top');
        var header = document.querySelector('header');
        if (!btn || !header) return;

        new IntersectionObserver(function (entries) {
          var visible = entries[0].isIntersecting;
          btn.classList.toggle('opacity-0', visible);
          btn.classList.toggle('pointer-events-none', visible);
          btn.classList.toggle('translate-y-2', visible);
        }).observe(header);

        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>
  </body>
</html>
