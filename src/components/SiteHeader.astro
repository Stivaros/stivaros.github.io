---
import ThemeToggle from '@components/ThemeToggle.astro';
import NavLink from '@components/NavLink.astro';

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const navItems = [
  { href: '/',         path: '~'          },
  { href: '/thoughts', path: '~/thoughts' },
  { href: '/systems',  path: '~/systems'  },
  { href: '/archive',  path: '~/archive'  },
] as const;
---

<header class="relative border-b border-subtle bg-zinc-950 light:bg-white font-mono text-xs">
  <div class="flex items-stretch">

    <button
      id="menu-toggle"
      aria-expanded="false"
      aria-controls="nav-items"
      class="sm:hidden flex items-center px-4 py-3 text-zinc-400 light:text-zinc-600 hover:text-zinc-200 light:hover:text-zinc-800 border-r border-subtle"
    >
      <span id="menu-label">[ menu + ]</span>
    </button>

    <!--
      Single render of nav items.
      Desktop (sm+): sm:contents makes this wrapper transparent to the flex row,
        so tabs become direct flex children alongside ThemeToggle.
      Mobile closed: hidden.
      Mobile open (via JS): flex flex-col absolute top-full = dropdown below header.
      bg/border/divide only render when the box exists (ignored under display:contents).
    -->
    <div
      id="nav-items"
      class="hidden sm:contents absolute top-full left-0 right-0 z-10
             bg-zinc-950 light:bg-white border-b border-subtle
             divide-y divide-zinc-800 light:divide-zinc-200"
    >
      {navItems.map(({ href, path }) => (
        <NavLink href={href} path={path} active={isActive(href)} />
      ))}
      <div class="flex-1 hidden sm:block" />
    </div>

    <div class="flex items-center px-3 border-l border-subtle text-muted">
      <ThemeToggle />
    </div>

  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('nav-items');
  const label = document.getElementById('menu-label');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (open) {
      nav?.classList.add('hidden');
      nav?.classList.remove('flex', 'flex-col');
    } else {
      nav?.classList.remove('hidden');
      nav?.classList.add('flex', 'flex-col');
    }
    if (label) label.textContent = open ? '[ menu + ]' : '[ menu - ]';
  });
</script>
