---
---

<div class="my-8">
  <div role="tablist" aria-label="Content view" class="flex gap-0 border-b border-subtle mb-6">
    <button
      role="tab"
      data-tab="prose"
      aria-selected="true"
      aria-controls="panel-prose"
      id="tab-prose"
      class="tab-btn tab-btn-active"
    >
      Prose
    </button>
    <button
      role="tab"
      data-tab="diagram"
      aria-selected="false"
      aria-controls="panel-diagram"
      id="tab-diagram"
      class="tab-btn"
    >
      Diagram
    </button>
  </div>

  <div
    id="panel-prose"
    role="tabpanel"
    aria-labelledby="tab-prose"
  >
    <slot name="prose" />
  </div>

  <div
    id="panel-diagram"
    role="tabpanel"
    aria-labelledby="tab-diagram"
    hidden
  >
    <slot name="diagram" />
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[role="tablist"]').forEach((tablist) => {
    const tabs = tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetPanelId = tab.getAttribute('aria-controls');
        if (!targetPanelId) return;
        const targetPanel = document.getElementById(targetPanelId);
        if (!targetPanel) return;

        tabs.forEach((t) => {
          t.setAttribute('aria-selected', 'false');
          t.classList.remove('tab-btn-active');
          const panelId = t.getAttribute('aria-controls');
          if (panelId) {
            const panel = document.getElementById(panelId);
            if (panel) panel.hidden = true;
          }
        });

        tab.setAttribute('aria-selected', 'true');
        tab.classList.add('tab-btn-active');
        targetPanel.hidden = false;
      });
    });
  });
</script>
